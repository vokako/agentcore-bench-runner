{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCliApiKeys",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:<region>:<account-id>:secret:bench/qoder-api-key-*",
        "arn:aws:secretsmanager:<region>:<account-id>:secret:bench/codebuddy-api-key-*"
      ]
    }
  ]
}
